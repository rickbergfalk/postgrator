{
  "name": "postgrator",
  "version": "8.0.0",
  "author": "Rick Bergfalk <rick.bergfalk@gmail.com>",
  "description": "A SQL migration tool for SQL people",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "keywords": [
    "migrator",
    "migration",
    "postgres",
    "postgresql",
    "mysql",
    "sql server",
    "sql"
  ],
  "lint-staged": {
    "*.{js,ts,mjs,cjs,json,css,md}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "precommit": "lint-staged",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && eslint \"**/*.{js,mjs,cjs}\" && prettier --check .",
    "prettier-write": "prettier --write .",
    "test": "node --import tsx --test --test-concurrency=1 \"test/*.test.ts\"",
    "prepare": "husky",
    "prepack": "npm run build"
  },
  "dependencies": {
    "glob": "^14.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/rickbergfalk/postgrator.git"
  },
  "main": "./dist/postgrator.js",
  "types": "./dist/postgrator.d.ts",
  "exports": {
    ".": {
      "types": "./dist/postgrator.d.ts",
      "default": "./dist/postgrator.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mssql": "^12.3.0",
    "@types/mysql": "^2.15.28",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mssql": "^12.7.13",
    "mysql": "^2.18.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "sqlite3": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "sqlite3@6.0.1": true
  }
}
